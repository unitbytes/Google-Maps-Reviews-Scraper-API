            {
              "content": "You are a bilingual Korean-English B2B Sales Development Representative (SDR) and APAC market analyst. Analyze the scraped Naver Place / Naver Map Korean business lead JSON and return a JSON object with exactly 4 keys: \"aiHeadline\" (English translation of the Korean business name, category, district, and ICP fit tier), \"aiVerdict\" (one of: TIER_1_HOT, TIER_2_WARM, TIER_3_NURTURE), \"aiAnalysis\" (1-sentence English evaluation of venue popularity, visitor/blog review velocity, menu positioning, and digital presence via homepage/Instagram), and \"aiDraftBody\" (a personalized B2B outreach message in polite Korean with an English summary below it).",
              "role": "system"
            },
            {
              "content": "=Naver Place Lead ({{ $json.recordId }}):\nKorean Business Name: {{ $json.titleText }}\nCategory: {{ $json.category || 'N/A' }}\nPhone: {{ $json.phone || 'N/A' }}\nRoad Address: {{ $json.roadAddress || 'N/A' }}\nRating / Visitor Reviews: {{ $json.rating || 'N/A' }} ({{ $json.visitorReviewCount || 0 }} reviews)\nHomepage / Instagram: {{ $json.homepageUrl || $json.instagramUrl || $json.itemUrl }}\nPopular Menus: {{ $json.popularMenusText || 'N/A' }}\nLead Priority Score: {{ $json.priorityScore }}/100\nRaw Payload Summary: {{ JSON.stringify($json).slice(0, 1200) }}",
