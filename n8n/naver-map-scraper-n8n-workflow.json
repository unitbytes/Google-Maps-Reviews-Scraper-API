    {
      "parameters": {
        "jsCode": "// Normalize fields, parse numeric metrics, and score items for AI enrichment\nconst config = $('1. Configure Search & Rules').first().json;\nconst threshold = Number(config.minLeadScore !== undefined ? config.minLeadScore : 70);\nconst keywordFilter = String(config.priorityKeyword || '').trim().toLowerCase();\nconst primaryKeys = [\"placeId\", \"name\", \"category\", \"phone\", \"roadAddress\", \"rating\", \"visitorReviewCount\", \"homepageUrl\", \"url\"];\n\nreturn $input.all().map((item) => {\n  const raw = item.json || {};\n  const cleaned = { ...raw };\n\n  for (const k of primaryKeys) {\n    if (typeof cleaned[k] === 'string') {\n      cleaned[k] = cleaned[k].replace(/\\s+/g, ' ').trim();\n    }\n  }\n\n  const recordId = String(cleaned.placeId || cleaned.id || cleaned.url || '');\n  const titleText = String(cleaned.name || recordId).slice(0, 180);\n  const itemUrl = String(cleaned.url || cleaned.homepageUrl || '');\n  const rawMetric = cleaned.visitorReviewCount || cleaned.rating || 0;\n  const numericValue = Number(String(rawMetric).replace(/[^0-9.-]/g, '')) || 0;\n\n  let priorityScore = 50;\n  let isHighPriority = false;\n\n  let naverScore = 40;\n  if (cleaned.phone) naverScore += 20;\n  if (cleaned.homepageUrl || cleaned.instagramUrl) naverScore += 15;\n  if (Number(cleaned.visitorReviewCount || 0) >= 30) naverScore += 15;\n  if (Number(cleaned.rating || 0) >= 4.3) naverScore += 10;\n  priorityScore = Math.min(100, naverScore);\n  if (priorityScore >= threshold) {\n    isHighPriority = true;\n  }\n\n  if (keywordFilter && titleText.toLowerCase().includes(keywordFilter)) {\n    priorityScore = Math.min(100, priorityScore + 20);\n    isHighPriority = true;\n  }\n\n  return {\n    json: {\n      ...cleaned,\n      recordId,\n      titleText,\n      itemUrl,\n      numericValue,\n      priorityScore,\n      isHighPriority,\n      alertSummary: titleText + ' (Metric: ' + numericValue + ' | Score: ' + priorityScore + '/100)',\n      scrapedAt: new Date().toISOString(),\n    },\n  };\n});"
      },
      "id": "481230e4-7621-571f-a1a1-64d437c5ac6a",
      "name": "4. Clean & Score Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        220
      ]
